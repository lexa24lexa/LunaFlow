<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- App Theme -->
    <style name="Theme.LunaFlow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- App main background -->
        <item name="android:windowBackground">@color/white</item>

        <!-- Primary surfaces (toolbar, app bar, etc.) -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/mainBrown</item> <!-- ensures icons/text on primary are brown -->

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/mainRed</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/colorPrimary</item>

        <!-- Toolbar / ActionBar -->
        <item name="actionBarTheme">@style/AppActionBar</item>

        <!-- Bottom Navigation -->
        <item name="bottomNavigationStyle">@style/BottomNavStyle</item>
    </style>

    <!-- Custom toolbar style: smaller height + correct text color -->
    <style name="AppActionBar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:layout_height">48dp</item> <!-- smaller header -->
        <item name="android:background">@color/colorPrimary</item> <!-- header bg -->
        <item name="titleTextColor">@color/mainBrown</item> <!-- header text -->
        <item name="subtitleTextColor">@color/mainBrown</item>
        <item name="android:theme">@style/ToolbarTextTheme</item> <!-- enforce text color -->
    </style>

    <!-- Toolbar text theme to force mainBrown for all text/icons -->
    <style name="ToolbarTextTheme" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="android:textColorPrimary">@color/mainBrown</item>
        <item name="android:textColorSecondary">@color/mainBrown</item>
        <item name="android:textColor">@color/mainBrown</item>
    </style>

    <!-- Bottom nav text styles -->
    <style name="BottomNavText">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mainBrown</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="BottomNavText.Selected">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mainRed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Custom Bottom NavigationView style -->
    <style name="BottomNavStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:layout_height">50dp</item> <!-- shorter nav -->
        <item name="android:background">@color/colorPrimary</item>
    </style>

</resources>
