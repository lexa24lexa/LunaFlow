<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activities"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/filterSex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sex"/>

        <CheckBox
            android:id="@+id/filterMasturbation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masturbation"/>

        <CheckBox
            android:id="@+id/filterPlanB"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plan B"/>

        <CheckBox
            android:id="@+id/filterBirthControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Birth control"/>

        <CheckBox
            android:id="@+id/filterOtherMed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Other medication"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Symptoms"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <CheckBox
            android:id="@+id/filterPhysical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Physical symptoms"/>

        <CheckBox
            android:id="@+id/filterEmotional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emotional symptoms"/>

        <CheckBox
            android:id="@+id/filterFlow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menstruation flow"/>
    </LinearLayout>
</ScrollView>
